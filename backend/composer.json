{
  "name": "decaspark/commerce-backend",
  "description": "Decaspark modular Laravel 11+ backend for digital distribution, print fulfillment, service intakes, and multi-seat team licensing.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^11.36",
    "league/flysystem-aws-s3-v3": "^3.29",
    "predis/predis": "^2.3"
  },
  "require-dev": {
    "laravel/pint": "^1.18",
    "nunomaduro/larastan": "^2.9",
    "pestphp/pest": "^3.5",
    "pestphp/pest-plugin-laravel": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
