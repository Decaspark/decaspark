APP_NAME="Decaspark API"
APP_ENV=production
APP_URL=https://api.decaspark.com
FRONTEND_URL=https://decaspark.vercel.app

# PostgreSQL / Supabase Direct & Pooler Configuration
DB_CONNECTION=pgsql
DB_HOST=db.project-ref.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=require

# Redis Cache, Rate Limiter & Queue Transport
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Isolated Private Object Storage (Cloudflare R2 / AWS S3 / S3-Compatible)
DECASPARK_ASSET_DISK=r2_private
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=decaspark-private-vault
R2_ENDPOINT=https://account-id.r2.cloudflarestorage.com
R2_REGION=auto

# Digital Fulfillment & Token Policy
DECASPARK_DOWNLOAD_TTL_HOURS=24
DECASPARK_DOWNLOAD_MAX_COUNT=3
DECASPARK_STREAM_CHUNK_BYTES=65536

# Payment Webhook Signing Secrets
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
GUMROAD_WEBHOOK_SECRET=

# Logistics & Ops Alerting Endpoints
SHIPPING_PROVIDER_BASE_URL=https://api.fulfillment.example.com
SHIPPING_PROVIDER_API_KEY=
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_EMAIL=ops@decaspark.com
